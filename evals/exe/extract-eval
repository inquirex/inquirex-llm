#!/usr/bin/env ruby
# frozen_string_literal: true

# Unlike a released gem's executable, this one loads Bundler: the evals resolve
# inquirex and inquirex-llm from local paths that only evals/Gemfile knows.
ENV["BUNDLE_GEMFILE"] = File.expand_path("../Gemfile", __dir__)
require "bundler/setup"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "extract_eval"

ExtractEval::Launcher.new(ARGV).execute!
