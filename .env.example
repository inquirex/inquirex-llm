# Every variable inquirex-llm and its evals read. Copy to `.env`, fill in the
# values you need, and encrypt with sopsy; `.env` itself is gitignored.

# Gem adapters (Inquirex::LLM.configuration); set the ones you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Optional gem settings; blank keeps the default.
INQUIREX_LLM_ADAPTER=
INQUIREX_LLM_ANTHROPIC_MODEL=
INQUIREX_LLM_OPENAI_MODEL=
INQUIREX_LLM_OPENROUTER_MODEL=
INQUIREX_LLM_JEV_MODEL=
INQUIREX_DEBUG=

# evals/: OpenRouter contenders need OPENROUTER_API_KEY, typesafe-api/*
# contenders TYPESAFE_API_KEY, and every run without --local these two.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=
