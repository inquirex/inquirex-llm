# vim: ft=bash
PATH_add bin
PATH_add evals/exe

# Gem shims set BUNDLE_GEMFILE themselves. Do not set it here.
if [[ -f .env && .env -nt .env.encrypted ]]; then
  eval "$(cat .env | sed '/^#.*/d; /^$/d; s/^/export /g')"
elif [[ -f .env.encrypted ]]; then
  eval "$(sopsy decrypt .env.encrypted | sed '/^#.*/d; /^$/d; s/^/export /g')"
fi
